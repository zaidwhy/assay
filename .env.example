# Hosted LLM keys. Each provider is used only when its key is set; Ollama is the local last resort.
GROQ_API_KEY=
# Web search API (free tier at tavily.com); without it search falls back to keyless DuckDuckGo.
TAVILY_API_KEY=
# Optional extra fallback, project-scoped so a machine-wide OpenRouter key is never spent.
ASSAY_OPENROUTER_API_KEY=

# Optional: require this value in the X-API-Key header on every write endpoint.
ASSAY_API_KEY=

# Optional overrides (defaults shown).
ASSAY_DB_PATH=assay.db
ASSAY_USE_OLLAMA=true
ASSAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSAY_DEFAULT_DEADLINE_S=30
ASSAY_MAX_CONCURRENT_RUNS=8
ASSAY_QUEUE_CAP=32
ASSAY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
